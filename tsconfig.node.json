{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // Give tsc -b a real emit target inside node_modules. Without an outDir,
    // `composite` makes tsc emit vite.config.js next to the source and shadow
    // the TS config on the next run (the footgun hit in third-brain).
    "outDir": "./node_modules/.tmp/node-build",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
